* text=auto
*.cs text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.unity text eol=lf
*.prefab text eol=lf
*.meta text eol=lf
*.asset text eol=lf
*.blend filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
# Preserve embedded upstream bytes for the recorded package provenance.
Unity/FamilyPlayset/Packages/com.unity.transport/** -text
